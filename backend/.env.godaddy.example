# ----------------------------------------------------------------------
# GODADDY cPANEL MYSQL DATABASE SETTINGS
# Set these after creating your database & user in GoDaddy cPanel MySQL Wizard:
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourgodaddyuser_ebiz
